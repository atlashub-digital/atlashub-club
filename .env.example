# ══ PR2B · Supabase ════════════════════════════════════════════════════════════
# DECISÃO ATL-D29 (Founder): o Club usa a DB MASTER central aakdyumavlzgyklbrsrw
# (schema `club` para separar das tabelas existentes). NÃO criar projeto dedicado.
# Todas as tabelas do Club ficam no schema `club` da master (docs/sql/drafts/002 + 003).
# PLACEHOLDER: os valores reais estão nas env vars protegidas da Vercel (Helena).
# Enquanto não estiverem configuradas no ambiente, o modo live fica off e o site
# opera em modo lead/prévia (fail-closed).

# PUBLIC DOMAIN: independent of app.atlashub.si (em staging: o URL do Preview/staging)
CLUB_SITE_ORIGIN=https://club.atlashub.si
# PUBLIC: Cloudflare Turnstile site key (required before accepting leads; hostname do staging/produção)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SECRET: Never expose/commit; Turnstile verification required for accepting leads
TURNSTILE_SECRET_KEY=
# SECRET · DB MASTER central (ATL-D29): https://aakdyumavlzgyklbrsrw.supabase.co
SUPABASE_URL=https://aakdyumavlzgyklbrsrw.supabase.co
# SECRET · DB MASTER central (ATL-D29): service_role. Server-side only; nunca expor/commitar.
SUPABASE_SERVICE_ROLE_KEY=
# SECRET · DB MASTER central (ATL-D29): anon/publishable. Usada só no servidor
# (sessão em cookies httpOnly); o browser nunca recebe chaves Supabase.
SUPABASE_ANON_KEY=

# PR2B · registo real. off (defeito) | dry-run (só fora de produção) | live (exige TODAS as variáveis acima)
CLUB_AUTH_MODE=off
# Produção: só "yes" depois da aprovação escrita do Sérgio. Sem isto, produção fica em off.
CLUB_AUTH_PRODUCTION_APPROVED=
# CRM (opcional até a Helena definir o recetor): webhook HTTPS assinado com HMAC-SHA256
CLUB_CRM_WEBHOOK_URL=
CLUB_CRM_WEBHOOK_SECRET=
# Vercel Cron → /api/club/crm-sync (reenvio do outbox e retenção)
CRON_SECRET=
# Hosting: Set above in protected Preview/Production environmental variables