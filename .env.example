# ══ PR2B · Projeto Supabase Club DEDICADO ══════════════════════════════════════
# Todas as variáveis Supabase abaixo apontam para um projeto NOVO e DEDICADO ao Club Atlas
# (decisão do Founder: opção A — um projeto só do Club). NÃO reutilizar AtlasHub, XPayments,
# autohub360, Atendimento nem Workforce. PLACEHOLDERS: a criação do projeto e os valores reais
# são PENDÊNCIA DA HELENA (ver docs/17_PR2B_LIVE_SETUP.md §2). Enquanto os placeholders
# estiverem vazios, o modo live fica off e o site opera em modo lead/prévia (fail-closed).

# PUBLIC DOMAIN: independent of app.atlashub.si (em staging: o URL do Preview/staging)
CLUB_SITE_ORIGIN=https://club.atlashub.si
# PUBLIC: Cloudflare Turnstile site key (required before accepting leads; hostname do staging/produção)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SECRET: Never expose/commit; Turnstile verification required for accepting leads
TURNSTILE_SECRET_KEY=
# SECRET · projeto Supabase Club DEDICADO (Helena): URL do projeto novo, ex. https://<ref>.supabase.co
SUPABASE_URL=
# SECRET · projeto Supabase Club DEDICADO (Helena): service_role do MESMO projeto. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# SECRET · projeto Supabase Club DEDICADO (Helena): anon/publishable do MESMO projeto.
# Usada só no servidor (sessão em cookies httpOnly); o browser nunca recebe chaves Supabase.
SUPABASE_ANON_KEY=

# PR2B · registo real. off (defeito) | dry-run (só fora de produção) | live (exige TODAS as variáveis acima)
CLUB_AUTH_MODE=off
# Produção: só "yes" depois da aprovação escrita do Sérgio. Sem isto, produção fica em off.
CLUB_AUTH_PRODUCTION_APPROVED=
# CRM (opcional até a Helena definir o recetor): webhook HTTPS assinado com HMAC-SHA256
CLUB_CRM_WEBHOOK_URL=
CLUB_CRM_WEBHOOK_SECRET=
# Vercel Cron → /api/club/crm-sync (reenvio do outbox e retenção)
CRON_SECRET=
# Hosting: Set above in protected Preview/Production environmental variables